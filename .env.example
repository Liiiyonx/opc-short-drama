# ===== 数据库 =====
# 开发默认 SQLite（零配置）；切 MySQL 时改下面这行
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=mysql+aiomysql://opc:opc@127.0.0.1:3306/opc?charset=utf8mb4

# ===== Redis（arq 队列；DB1 与其他项目隔离）=====
REDIS_URL=redis://127.0.0.1:6379/1

# ===== JWT =====
JWT_SECRET=opc-dev-secret-change-me-in-production-2026
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ===== LLM 多模型网关（OpenAI 兼容；默认云端 DeepSeek）=====
# 密钥不放本文件：在 D:\VeriCall_data\secrets\opc_secrets.env 维护，
# bash 中 set -a; source <文件>; set +a 后再启动服务
LLM_PROVIDER=openai_compat
# LLM_PROVIDER=mock  # 仅无密钥联调/测试用（显式启用的测试桩，不是回退路径）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_DEFAULT=deepseek-v4-flash
# 按智能体覆盖（可留空跟随默认）
LLM_MODEL_SCRIPT=
LLM_MODEL_STORYBOARD=
LLM_MODEL_TRANSLATE=

# ===== TTS =====
TTS_PROVIDER=edge-tts
TTS_CONCURRENCY=4  # 配音逐行并行合成的并发上限（edge-tts websocket 并发）
# TTS_PROVIDER=mock  # 无网络/密钥联调用：ffmpeg 生成静音并按文本长度估算时长

# ===== 异步任务 =====
# 会话超过该秒数仍 running → 自动判失败（worker 崩溃/未启动兜底）
AGENT_TASK_TIMEOUT_SECONDS=1800

# ===== 对象存储 =====
# dev 用本地磁盘；prod 用 minio
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=opcadmin
MINIO_SECRET_KEY=opcadmin123
MINIO_BUCKET=opc
MINIO_SECURE=false

# ===== 媒体 =====
FFMPEG_PATH=ffmpeg

# ===== 智能体配额 =====
QUOTA_TEXT_CALLS_PER_USER_DAY=50
QUOTA_MEDIA_CALLS_PER_USER_DAY=10
