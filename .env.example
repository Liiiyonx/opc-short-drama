# ===== 运行环境 =====
# dev（本地/测试默认）| prod（docker compose 会自动注入，勿手动设）
# prod 下使用开发默认 JWT_SECRET 会拒绝启动
# OPC_ENV=dev

# ===== 数据库 =====
# 开发默认 SQLite（零配置）；生产由 compose 注入 MySQL 连接串
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# 本地连 MySQL 调试：mysql+aiomysql://opc:密码@127.0.0.1:3306/opc?charset=utf8mb4

# ===== Redis（arq 队列；DB1 与其他项目隔离）=====
REDIS_URL=redis://127.0.0.1:6379/1

# ===== JWT =====
# 生产必须替换为强随机值：openssl rand -hex 32
JWT_SECRET=opc-dev-secret-change-me-in-production-2026
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ===== CORS（可选）=====
# 逗号分隔的允许来源；留空时 dev 放开（vite 5173→8000）、prod 同源不开放跨域
# CORS_ORIGINS=https://stu.example.com,https://tea.example.com

# ===== LLM 多模型网关（OpenAI 兼容；默认云端 DeepSeek）=====
# 密钥不放本文件：在 D:\VeriCall_data\secrets\opc_secrets.env 维护，
# bash 中 set -a; source <文件>; set +a 后再启动服务
LLM_PROVIDER=openai_compat
# LLM_PROVIDER=mock  # 仅无密钥联调/测试用（显式启用的测试桩，不是回退路径）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_DEFAULT=deepseek-v4-flash
# 按智能体覆盖（可留空跟随默认）
LLM_MODEL_SCRIPT=
LLM_MODEL_STORYBOARD=
LLM_MODEL_TRANSLATE=

# ===== TTS =====
TTS_PROVIDER=edge-tts
TTS_CONCURRENCY=4  # 配音逐行并行合成的并发上限（edge-tts websocket 并发）
# TTS_PROVIDER=mock  # 无网络/密钥联调用：ffmpeg 生成静音并按文本长度估算时长

# ===== 异步任务 =====
# 会话超过该秒数仍 running → 自动判失败（worker 崩溃/未启动兜底）
# 须大于 worker 的 job_timeout（1500s）
AGENT_TASK_TIMEOUT_SECONDS=1800

# ===== 对象存储 =====
# dev 用本地磁盘；生产由 compose 注入 minio 连接
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=opcadmin
MINIO_SECRET_KEY=opcadmin123
MINIO_BUCKET=opc
MINIO_SECURE=false

# ===== docker compose 生产编排凭据（deploy.sh 使用；本地开发可忽略）=====
# 全部必填，缺项 compose 会拒绝启动（防弱口令带上公网）
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# MYSQL_USER=opc
REDIS_PASSWORD=
# MINIO_ROOT_USER=opcadmin
MINIO_ROOT_PASSWORD=
# MINIO_BUCKET=opc

# ===== 媒体 =====
FFMPEG_PATH=ffmpeg

# ===== 智能体配额 =====
QUOTA_TEXT_CALLS_PER_USER_DAY=50
# 媒体类（配音/成片/发布参数）每日配额；演示彩排建议调大到 100（demo_up.sh 默认已放宽）
QUOTA_MEDIA_CALLS_PER_USER_DAY=10

# ===== 上传限制（可选）=====
# UPLOAD_MAX_MB=100
# UPLOAD_ALLOWED_EXT=png,jpg,jpeg,webp,gif,mp3,wav,m4a,ogg,mp4,mov,webm,json,srt,vtt,txt
