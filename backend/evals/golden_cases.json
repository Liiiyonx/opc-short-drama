          "scenes": [
            { "no": 1, "content": "Night city establishing shot." },
            { "no": 2, "content": "Rooftop monologue about the first warehouse." }
          ]
        }
      },
      "expected_keys": ["shots"],
      "expected_outcome": "ok"
