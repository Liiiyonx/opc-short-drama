      "input": {
        "lines": [ { "line_id": 1, "text": "这是一句特别长的台词，需要考验字幕切分与跨文化改写的稳健性，中间夹杂了大量铺垫描写、人物独白、情绪递进与画面提示，甚至还有第二层括号内的补充说明（用于模拟真实剧本里常见的超长口播段），直到最后才落下真正的重点。", "role": "narrator" } ],
        "target_locale": "en-US"
      },
      "expected_keys": ["lines"],
      "expected_outcome": "ok"
    },
