        "episodes": 2,
        "episode_minutes": 2
      },
      "expected_keys": ["episodes"],
      "expected_outcome": "ok"
    },
    {
      "id": "script-missing-market",
      "agent_type": "script",
      "category": "edge",
      "market": "—",
      "input": { "genre": "逆袭", "episodes": 2, "episode_minutes": 2 },
      "expected_keys": [],
      "expected_outcome": "reject",
      "reject_reason": "缺 target_market 必填字段，契约闸门应 422"
    },
    {
      "id": "script-negative-episodes",
      "agent_type": "script",
      "category": "edge",
      "market": "北美",
      "input": { "genre": "逆袭", "target_market": "北美", "episodes": -1, "episode_minutes": 2 },
      "expected_keys": [],
      "expected_outcome": "reject",
      "reject_reason": "非法集数，契约闸门应 422"
    },
    {
      "id": "script-sensitive",
      "agent_type": "script",
      "category": "sensitive",
      "market": "北美",
      "input": { "genre": "赌博一夜暴富", "target_market": "北美", "episodes": 1, "episode_minutes": 1 },
