{
  "version": "1.0",
  "description": "黄金评测集（docs/08 §7.2）：30 条固定样例，覆盖 5 大市场 × 4 类智能体 × 正常/边界/敏感/超长输入。mock 模式下确定性运行，用于契约通过率回归；接入真实模型后同一套样例做质量与成本回归。",
  "cases": [
    {
      "id": "script-na-normal",
      "agent_type": "script",
      "category": "normal",
      "market": "北美",
      "input": { "genre": "逆袭", "target_market": "北美", "episodes": 2, "episode_minutes": 2 },
      "expected_keys": ["episodes"],
      "expected_outcome": "ok"
    },
    {
      "id": "script-sea-normal",
      "agent_type": "script",
      "category": "normal",
      "market": "东南亚",
      "input": { "genre": "电商", "target_market": "东南亚", "episodes": 3, "episode_minutes": 1 },
      "expected_keys": ["episodes"],
      "expected_outcome": "ok"
    },
    {
      "id": "script-jp-normal",
      "agent_type": "script",
      "category": "normal",
      "market": "日韩",
      "input": { "genre": "甜宠", "target_market": "日韩", "episodes": 2, "episode_minutes": 2 },
