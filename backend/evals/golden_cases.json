      "expected_keys": ["episodes"],
      "expected_outcome": "ok"
    },
    {
      "id": "script-minimal",
      "agent_type": "script",
      "category": "edge",
      "market": "北美",
      "input": { "genre": "逆袭", "target_market": "北美", "episodes": 1, "episode_minutes": 1 },
      "expected_keys": ["episodes"],
      "expected_outcome": "ok"
