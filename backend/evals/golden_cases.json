      "agent_type": "translate",
      "category": "normal",
      "market": "北美",
      "input": {
        "lines": [
          { "line_id": 1, "text": "They said a delivery boy can't build an empire.", "role": "protagonist" },
          { "line_id": 2, "text": "Six months later — forty-seven stores.", "role": "protagonist" }
