            { "no": 1, "content": "Market awning at dawn." },
            { "no": 2, "content": "First viral order notification." },
            { "no": 3, "content": "Packing handmade bags at midnight." }
          ]
        },
        "style_hint": "warm realism"
      },
      "expected_keys": ["shots"],
      "expected_outcome": "ok"
    },
